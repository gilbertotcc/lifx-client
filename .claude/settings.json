{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew check*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew spockTest*)",
      "Bash(./gradlew build*)",
      "Bash(./gradlew checkstyle*)",
      "Bash(npx markdownlint-cli2*)",
      "Bash(lychee *)",
      "WebFetch(domain:api.developer.lifx.com)"
    ],
    "ask": [
      "Bash(./gradlew *integrationTest*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(less .env*)"
    ]
  }
}
